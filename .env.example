# From https://developers.kite.trade -> your app
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Exchanges whose instrument lists are downloaded for search (once per day)
KITE_EXCHANGES=NSE,BSE,NFO,BFO,MCX

# Lot sizes enforced for index derivatives (orders must be whole lots)
KITE_LOT_SIZES=NIFTY:65,SENSEX:20

# Set to 1 to explore the UI with simulated data (no Kite account needed)
KITE_MOCK=0

PORT=5000
